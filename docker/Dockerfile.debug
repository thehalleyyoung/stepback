# syntax=docker/dockerfile:1.7
#
# Debug image for `sb proxy` — same Python 3.11 ABI as the distroless image
# but ships a real shell, curl, and the gRPC extra so operators can:
#   * `docker exec -it ... bash` and inspect a misbehaving recorder
#   * `curl http://127.0.0.1:4319/healthz` from inside the container
#   * run the optional gRPC transport (`--grpc-listen`)
#
# This is *not* the production image. Use docker/Dockerfile.distroless for
# anything user-facing; reach for this one only when triaging.
#
# Build:
#   docker build -f docker/Dockerfile.debug -t stepback/proxy:debug .
#
# Run:
#   docker run --rm -it -p 4319:4319 \
#     -v "$PWD/traces:/var/lib/stepback/traces" \
#     stepback/proxy:debug

ARG PYTHON_VERSION=3.11

FROM python:${PYTHON_VERSION}-slim-bookworm

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Tools that are useful inside a triage shell. Kept small but not minimal.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        curl ca-certificates jq tini procps less \
 && rm -rf /var/lib/apt/lists/*

# Non-root account, mirroring the distroless `nonroot` UID/GID (65532).
RUN groupadd --system --gid 65532 stepback \
 && useradd  --system --uid 65532 --gid 65532 --home /home/stepback --shell /bin/bash stepback \
 && mkdir -p /home/stepback /var/lib/stepback/traces \
 && chown -R stepback:stepback /home/stepback /var/lib/stepback

WORKDIR /src

COPY pyproject.toml MANIFEST.in README.md LICENSE CITATION.cff ./
COPY stepback/ ./stepback/

RUN python -m pip install --upgrade pip \
 && python -m pip install ".[proxy-grpc]"

USER stepback
WORKDIR /home/stepback

VOLUME ["/var/lib/stepback/traces"]
EXPOSE 4319

LABEL org.opencontainers.image.title="stepback-proxy (debug)" \
      org.opencontainers.image.description="Debug-friendly variant of stepback-proxy: shell, curl, jq, tini." \
      org.opencontainers.image.source="https://github.com/stepback-dev/stepback" \
      org.opencontainers.image.licenses="Apache-2.0"

# tini reaps zombies and forwards signals — handy when shelling in.
ENTRYPOINT ["/usr/bin/tini", "--", "stepback"]
CMD ["proxy", "--listen", "0.0.0.0:4319", "--write", "/var/lib/stepback/traces"]
