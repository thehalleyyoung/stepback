{
  "name": "langchain_tool_invoke_dict",
  "description": "LangChain BaseTool.invoke({...}) returning a JSON-serializable dict.",
  "provider": "langchain",
  "request": {
    "tool_name": "lookup_customer",
    "description": "Look up a customer record by id.",
    "arguments": {"customer_id": 42}
  },
  "raw_response": {"name": "Acme Corp", "tier": "gold", "balance_usd": 1234.56},
  "contract": {
    "tool_outputs": {
      "name_recorded_as": "lookup_customer",
      "arguments_recorded_as": {"customer_id": 42},
      "result": {"name": "Acme Corp", "tier": "gold", "balance_usd": 1234.56}
    }
  }
}
