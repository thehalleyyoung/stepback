{
  "name": "mcp_call_tool_simple",
  "description": "MCP ClientSession.call_tool returning a structured payload.",
  "provider": "mcp",
  "request": {
    "server_name": "filesystem",
    "tool_name": "read_file",
    "arguments": {"path": "/tmp/example.txt"}
  },
  "raw_response": {"contents": "hello\n", "mime_type": "text/plain"},
  "contract": {
    "tool_outputs": {
      "name_recorded_as": "filesystem:read_file",
      "arguments_recorded_as": {"path": "/tmp/example.txt"},
      "result": {"contents": "hello\n", "mime_type": "text/plain"}
    }
  }
}
